<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title><%: Page.Title %> | Ajeet Yadav - .NET Software Engineer</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow-sm" id="mainNav">
            <div class="container">
                <a class="navbar-brand fw-bold" href="Default.aspx">
                    <span class="brand-icon"><i class="fas fa-code"></i></span>
                    Ajeet<span class="text-accent">Yadav</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" href="Default.aspx"><i class="fas fa-home me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="About.aspx"><i class="fas fa-user me-1"></i> About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Experience.aspx"><i class="fas fa-briefcase me-1"></i> Experience</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Skills.aspx"><i class="fas fa-cogs me-1"></i> Skills</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Projects.aspx"><i class="fas fa-project-diagram me-1"></i> Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-contact ms-lg-2" href="Contact.aspx"><i class="fas fa-envelope me-1"></i> Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-4 col-md-6">
                        <h5 class="footer-brand mb-3">
                            <i class="fas fa-code me-2"></i>Ajeet Yadav
                        </h5>
                        <p class="footer-desc mb-3">
                            Passionate .NET Software Engineer with 4+ years of experience building enterprise-grade web applications.
                        </p>
                        <div class="social-links">
                            <a href="mailto:codewithajeetyadav@gmail.com" title="Email"><i class="fas fa-envelope"></i></a>
                            <a href="https://github.com" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                            <a href="https://linkedin.com" target="_blank" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h6 class="footer-title">Quick Links</h6>
                        <ul class="footer-links">
                            <li><a href="Default.aspx">Home</a></li>
                            <li><a href="About.aspx">About</a></li>
                            <li><a href="Experience.aspx">Experience</a></li>
                            <li><a href="Skills.aspx">Skills</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h6 class="footer-title">Expertise</h6>
                        <ul class="footer-links">
                            <li>ASP.NET MVC / Web Forms</li>
                            <li>.NET Core & Web API</li>
                            <li>SQL Server & Reporting</li>
                            <li>AI Face Recognition</li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h6 class="footer-title">Contact</h6>
                        <ul class="footer-contact">
                            <li><i class="fas fa-map-marker-alt me-2"></i> Gurgaon, Haryana</li>
                            <li><i class="fas fa-phone me-2"></i> +91-9315710478</li>
                            <li><i class="fas fa-envelope me-2"></i> codewithajeetyadav@gmail.com</li>
                        </ul>
                    </div>
                </div>
                <hr class="footer-divider" />
                <div class="text-center footer-copy py-3">
                    <small>&copy; <%= DateTime.Now.Year %> Ajeet Yadav. All rights reserved.</small>
                </div>
            </div>
        </footer>
    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="Scripts/site.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
